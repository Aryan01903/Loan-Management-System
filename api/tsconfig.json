{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node16",
    "ignoreDeprecations": "5.0",
    "target": "es2020",
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"]
}